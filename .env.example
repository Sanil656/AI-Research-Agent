# LLM Provider Keys (Choose at least one)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional: Higher-quality web search API (falls back to DuckDuckGo search automatically if omitted)
TAVILY_API_KEY=your_tavily_api_key_here

# Default Model Selection (Optional)
# Options: "groq", "gemini", "openai", "ollama"
DEFAULT_LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b

# MySQL Database Configuration (for User Authentication & Persistent History)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=research_agent_db
